  "info": {
    "title": "Amrutam Telemedicine API",
    "description": "Secure, idempotent REST API for telemedicine workflows",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [{ "url": "/" }],
  "components": {
    "securitySchemes": { "bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" } },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "example": "patient@example.com" },
          "password": { "type": "string", "minLength": 12, "example": "Str0ng!Passphrase" },
          "fullName": { "type": "string", "example": "Aarav Sharma" },
          "role": { "type": "string", "enum": ["PATIENT", "DOCTOR"], "default": "PATIENT" },
          "phone": { "type": "string", "example": "+919876543210" },
          "specialization": { "type": "string", "example": "Ayurveda" },
          "licenseNumber": { "type": "string", "example": "MED-12345" },
          "consultationFeeCents": {
            "type": "number",
            "example": 150000,
            "description": "Fee in minor currency units (paise)"
          }
        },
        "required": ["email", "password", "fullName"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "example": "patient@example.com" },
          "password": { "type": "string" },
          "totpCode": { "type": "string", "example": "123456" }
        },
        "required": ["email", "password"]
      },
      "RefreshDto": {
        "type": "object",
        "properties": { "refreshToken": { "type": "string" } },
        "required": ["refreshToken"]
      },
      "MfaVerifyDto": {
        "type": "object",
        "properties": { "code": { "type": "string", "example": "123456" } },
        "required": ["code"]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string", "example": "Aarav Sharma" },
          "phone": { "type": "string", "example": "+919876543210" },
          "dateOfBirth": { "type": "string", "example": "1990-01-01" }
        }
      },
      "Object": { "type": "object", "properties": {} },
      "UpdateUserStatusDto": {
        "type": "object",
        "properties": { "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "DELETED"] } }
      },
      "CreateAvailabilityDto": {
        "type": "object",
        "properties": {
          "startsAt": { "type": "string", "example": "2026-10-01T09:00:00.000Z" },
          "endsAt": { "type": "string", "example": "2026-10-01T09:30:00.000Z" }
        },
        "required": ["startsAt", "endsAt"]
      },
      "UpdateDoctorActivationDto": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean",
            "description": "Approve or deactivate a verified doctor profile"
          }
        },
        "required": ["active"]
      },
      "BookConsultationDto": {
        "type": "object",
        "properties": {
          "slotId": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 3, "maxLength": 2000 }
        },
        "required": ["slotId", "reason"]
      },
      "UpdateConsultationStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["SCHEDULED", "IN_PROGRESS", "COMPLETED", "CANCELLED", "NO_SHOW"]
          },
          "expectedVersion": {
            "type": "number",
            "description": "Current resource version for optimistic concurrency"
          },
          "clinicalNotes": { "type": "string", "maxLength": 10000 }
        },
        "required": ["status", "expectedVersion"]
      },
      "MedicationDto": { "type": "object", "properties": {} },
      "CreatePrescriptionDto": {
        "type": "object",
        "properties": {
          "medications": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MedicationDto" }
          },
          "instructions": { "type": "string", "maxLength": 4000 }
        },
        "required": ["medications"]
      },
      "UpdatePaymentStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["PENDING", "AUTHORIZED", "CAPTURED", "REFUNDED", "FAILED"]
          },
          "providerReference": { "type": "string" }
        },
        "required": ["status"]
      }
    }
  }
}
