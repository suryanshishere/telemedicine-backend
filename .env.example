NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://amrutam:amrutam@localhost:5432/amrutam?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated key-id:base64-encoded-32-byte-key values. Keep old keys during rotation.
FIELD_ENCRYPTION_KEYS=v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ACTIVE_FIELD_KEY_ID=v1
ALLOWED_ORIGINS=http://localhost:3001
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HOPS=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=8
